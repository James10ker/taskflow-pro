# Local Vite forwards same-origin /api requests to this backend.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8080

# Keep this unset for the local proxy and same-origin production deployments.
# Set it only when the API is intentionally hosted at a different origin.
# VITE_API_BASE_URL=https://api.example.com/api
